# Copy to .env.local and fill in. Never commit .env.local.
# Public variables (NEXT_PUBLIC_*) are sent to browsers; never put a secret in one.

# Canonical site address, used for metadata, sitemap and share links. Production: https://learn.practicode.tech
NEXT_PUBLIC_SITE_URL=
# Supabase project URL (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
# Supabase publishable key (safe in browsers; row-level security protects the data)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Where lessons come from: "samples" (bundled sample lesson, no Supabase needed) or "supabase"
NEXT_PUBLIC_CONTENT_SOURCE=
# Google Search Console verification token (the content of the meta tag)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools verification token
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Server-only secrets. Set them in Vercel's environment settings; paste them locally yourself.
# Supabase secret key: bypasses row-level security, so it is only read by code that imports "server-only"
SUPABASE_SECRET_KEY=
# Shared secret the content repository sends to /api/revalidate (32+ characters)
REVALIDATE_SECRET=
# Secret Vercel Cron sends to scheduled routes (32+ characters)
CRON_SECRET=

# Groq API key for the AI tutor (console.groq.com → API Keys)
GROQ_API_KEY=

# Paystack secret key (sk_test_... or sk_live_...) for Pro checkout. Without it, checkout says payments
# aren't open. Set the webhook in Paystack to <site>/api/webhooks/paystack.
PAYSTACK_SECRET_KEY=
# Paystack public key. Not used yet: checkout runs on Paystack's own page.
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# Resend API key (sending access) for sign-in emails. Not read by the app: npm run auth:push sends it to
# Supabase as the SMTP password.
RESEND_SMTP_KEY=

# Database tests (row-level security) run against the hosted dev project, never production
SUPABASE_TEST_URL=
SUPABASE_TEST_PUBLISHABLE_KEY=
SUPABASE_TEST_SECRET_KEY=
